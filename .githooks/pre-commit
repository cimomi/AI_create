#!/usr/bin/env bash
# Fast pre-commit check: gitleaks (staged) plus the repository audit
# (current files only). The full gate runs in pre-push.
#
# Note: --no-verify bypasses local hooks, which is why a server-side CI
# workflow exists as a backstop (.github/workflows/security.yml).
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
FAIL=0

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact --config "$ROOT/.gitleaks.toml" || FAIL=1
else
  echo "NOTE: gitleaks not installed (brew install gitleaks); secret scan skipped." >&2
fi

python3 "$ROOT/scripts/audit.py" --no-history || FAIL=1
exit $FAIL
