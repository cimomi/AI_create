#!/usr/bin/env bash
# 提交前快检：gitleaks（暂存区）+ 本仓库审计（不扫历史，快）。
# 真正的完整拦截在 pre-push。注意 --no-verify 可以绕过本地钩子，
# 所以服务端还有 CI 兜底（.github/workflows/security.yml）。
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
FAIL=0

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact --config "$ROOT/.gitleaks.toml" || FAIL=1
else
  echo "提示：未安装 gitleaks（brew install gitleaks），本次跳过密钥扫描。" >&2
fi

python3 "$ROOT/scripts/audit.py" --no-history || FAIL=1
exit $FAIL
