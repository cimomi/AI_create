#!/usr/bin/env bash
# Full security gate before a public push. This is the *local* layer.
#
#   1. gitleaks            secrets, across the whole history
#   2. scripts/audit.py    absolute paths, credential files, oversized files,
#                          probable third-party content — across the whole history
#   3. CI (server-side)    .github/workflows/security.yml
#                          Local hooks can be bypassed with --no-verify; CI cannot.
#                          But CI runs *after* the push, so it detects rather than
#                          prevents. GitHub Push Protection is what actually blocks.
#
# Any failure refuses the push.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
FAIL=0

if command -v gitleaks >/dev/null 2>&1; then
  echo "-- gitleaks: scanning the full history --"
  gitleaks git --no-banner --redact --config "$ROOT/.gitleaks.toml" || FAIL=1
else
  echo "WARNING: gitleaks not installed (brew install gitleaks); one layer is missing." >&2
fi

echo
echo "-- repository audit: current files + full history --"
python3 "$ROOT/scripts/audit.py" || FAIL=1

if [ "$FAIL" -ne 0 ]; then
  echo
  echo "Push blocked. Fix the findings and retry; do not use --no-verify." >&2
fi
exit $FAIL
